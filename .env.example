# ========================
# Environment Configuration
# ========================

# -----------------------------------------------
# BPJS APLICARE API
# -----------------------------------------------
# URL base API BPJS Kesehatan
# Development: https://dvlp.bpjs-kesehatan.go.id:8888
# Production:  https://new-api.bpjs-kesehatan.go.id
BPJS_BASE_URL=https://new-api.bpjs-kesehatan.go.id

# Consumer ID yang diberikan oleh BPJS Kesehatan
BPJS_CONS_ID=your_consumer_id

# Consumer Secret Key untuk generate HMAC-SHA256 signature
BPJS_SECRET_KEY=your_consumer_secret_key

# User Key untuk layanan APLICARE
BPJS_USER_KEY=your_user_key

# Kode PPK / Kode Faskes (Kode RS di BPJS)
BPJS_KODE_PPK=12345678

# -----------------------------------------------
# SIRANAP Kemenkes
# -----------------------------------------------
# URL base SIRANAP / RS Online Kemenkes
SIRANAP_BASE_URL=https://sirs.kemkes.go.id

# Kode Rumah Sakit (dari RS Online Kemenkes)
SIRANAP_RS_ID=your_kode_rs

# Password bridging dari RS Online / SIRANAP
SIRANAP_PASSWORD=your_siranap_password

# -----------------------------------------------
# Scheduler
# -----------------------------------------------
# Cron expression untuk sinkronisasi otomatis
# Contoh:
#   */15 * * * *  = Setiap 15 menit
#   */30 * * * *  = Setiap 30 menit
#   0 * * * *     = Setiap 1 jam
#   0 */2 * * *   = Setiap 2 jam
SYNC_CRON=*/15 * * * *

# Aktifkan/nonaktifkan scheduler otomatis (true/false)
SYNC_ENABLED=true

# -----------------------------------------------
# Aplikasi
# -----------------------------------------------
PORT=3000
NODE_ENV=production

# Nama Rumah Sakit (untuk tampilan di dashboard)
RS_NAME=Nama Rumah Sakit Anda
